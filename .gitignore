# Python environment - platform-specific, rebuild it on each machine
venv/
__pycache__/
*.pyc

# Node deps for the slide-deck generator - reinstall with npm install
.docxbuild/node_modules/

# Runtime logs and local test artifacts
logs_*.txt
# live sensor readings + field reports - per-machine runtime data
data/reports/
*.simulated-backup

# Duplicate blank templates downloaded to the repo root; the filled versions
# live in exhibition/
/Startup_*Template*.pptx

# OS clutter
.DS_Store
Thumbs.db

# Local secrets, if any ever get added
.env

# Overnight Overpass re-fetch of the road network with topology; regenerate
# with scripts/fetch_roads_topo.py rather than committing 100+ MB of it
data/geo/roads_topo.json
data/geo/roads_topo.json.tmp
